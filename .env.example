# CALDIM SmartAssist Companion — Environment Configuration (Vite)
#
# Production / Exhibition Kiosk Deployment Guide:
# - VITE_API_BASE_URL: Base URL of the CALDIM SmartAssist AI backend.
#   Leave blank to use relative endpoint paths (/api/v1/...) via kiosk reverse proxy.
#   Example: http://localhost:8000 or https://api.caldim.ai
VITE_API_BASE_URL=

# Request timeout in milliseconds for AI inference calls (default: 15000)
VITE_API_TIMEOUT_MS=15000

# Kiosk station identifier for exhibition auditing
VITE_KIOSK_ID=CALDIM-EXHIBIT-KIOSK-01
